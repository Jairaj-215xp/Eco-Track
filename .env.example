# ==============================================================================
# ECO-TRACK ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Backend & Authentication
# Create a free project at https://supabase.com
# Find these under: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Google Maps API Service
# Obtain API key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 3. Open Vision AI Service (Optional External Endpoint)
# By default, Eco-Track runs a high-performance browser-native Open Vision AI model.
# If you host a dedicated YOLOv8 / DETR / Hugging Face model, configure it here:
VITE_OPEN_VISION_API_URL=
VITE_OPEN_VISION_API_KEY=
